<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Instagram Login Clone</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    body {
      background: #fafafa;
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 350px;
      margin: 50px auto;
      background: #fff;
      border: 1px solid #dbdbdb;
      padding: 40px 40px 20px 40px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .logo {
      display: block;
      margin: 0 auto 30px auto;
      width: 175px;
    }
    .input-group {
      margin-bottom: 8px;
    }
    input[type="text"], input[type="password"] {
      width: 100%;
      padding: 10px;
      border: 1px solid #dbdbdb;
      border-radius: 4px;
      background: #fafafa;
      font-size: 14px;
      margin-bottom: 6px;
    }
    .login-btn {
      width: 100%;
      padding: 10px 0;
      background: #4cb5f9;
      color: #fff;
      border: none;
      border-radius: 4px;
      font-weight: bold;
      font-size: 14px;
      cursor: pointer;
      margin-top: 10px;
      margin-bottom: 15px;
    }
    .login-btn:disabled {
      background: #b2dffc;
      cursor: not-allowed;
    }
    .divider {
      display: flex;
      align-items: center;
      margin: 18px 0;
    }
    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #dbdbdb;
    }
    .divider span {
      margin: 0 10px;
      color: #8e8e8e;
      font-size: 13px;
      font-weight: 600;
    }
    .facebook-login {
      color: #385185;
      font-size: 14px;
      font-weight: bold;
      text-align: center;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .facebook-login img {
      width: 20px;
      margin-right: 8px;
    }
    .forgot {
      text-align: center;
      color: #00376b;
      font-size: 12px;
      margin-bottom: 20px;
      text-decoration: none;
      display: block;
    }
    .signup-container {
      max-width: 350px;
      margin: 10px auto;
      background: #fff;
      border: 1px solid #dbdbdb;
      border-radius: 8px;
      padding: 20px 0;
      text-align: center;
      font-size: 14px;
    }
    .signup-link {
      color: #0095f6;
      text-decoration: none;
      font-weight: bold;
    }
    .get-app {
      text-align: center;
      margin: 20px 0;
      font-size: 14px;
      color: #8e8e8e;
    }
    .app-stores img {
      width: 135px;
      margin: 8px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="container">
    <img src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Instagram_icon.png" alt="Instagram Logo" class="logo">
    <form>
      <div class="input-group">
        <input type="text" placeholder="Phone number, username, or email" required>
      </div>
      <div class="input-group">
        <input type="password" placeholder="Password" required>
      </div>
      <button type="submit" class="login-btn">Log In</button>
      <div class="divider"><span>OR</span></div>
      <a href="#" class="facebook-login">
        <img src="https://upload.wikimedia.org/wikipedia/commons/5/51/Facebook_f_logo_%282019%29.svg" alt="Facebook logo">
        Log in with Facebook
      </a>
      <a href="#" class="forgot">Forgot password?</a>
    </form>
  </div>
  <div class="signup-container">
    Don't have an account?
    <a href="#" class="signup-link">Sign up</a>
  </div>
  <div class="get-app">Get the app.</div>
  <div class="app-stores" style="text-align:center;">
    <a href="#"><img src="https://www.instagram.com/static/images/appstore-install-badges/badge_ios_english_en.png/9fc4bab7565b.png" alt="App Store"></a>
    <a href="#"><img src="https://www.instagram.com/static/images/appstore-install-badges/badge_android_english_en.png/6071ff4c484c.png" alt="Google Play"></a>
  </div>
</body>
</html>
